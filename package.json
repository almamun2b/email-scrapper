{
  "name": "email-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crawl websites from a CSV list and extract every email address into a name,email CSV",
  "scripts": {
    "scrape": "UV_THREADPOOL_SIZE=${UV_THREADPOOL_SIZE:-16} node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.64.0",
    "robots-parser": "^3.0.1",
    "tldts": "^7.4.18",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

{
  "name": "email-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Crawl websites from a CSV list and extract every email address into a name,email CSV",
  "scripts": {
    "scrape": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "p-limit": "^7.3.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.63.0",
    "robots-parser": "^3.0.1",
    "tldts": "^7.4.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
